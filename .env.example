# Nebius Token Factory — get a key at https://tokenfactory.nebius.com
# Promo code for $25 credits: NEBIUS-DEVPOST-GLOBAL26
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: Tavily web search (falls back to Wikipedia if empty)
TAVILY_API_KEY=

# Nemotron model routing. If an ID is not in the catalog, the server
# auto-picks a matching Nemotron model at startup (see logs).
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Force demo mode even with a key (1 = on)
MOCK_MODE=0

# Optional: OpenAlex scholarly search, used automatically for academic questions.
# Works without a key (about 100 searches/day); a free key from https://openalex.org raises that 10x.
OPENALEX_API_KEY=
# arXiv preprints are also searched for academic questions; no key needed (limited to one request every 3s).

# Testing only: make a scholarly connector fail to check partial-coverage reporting (e.g. openalex, arxiv, or openalex,arxiv)
NEMOSEARCH_SIMULATE_FAILURE=

# ---------------------------------------------------------------- accounts, storage and deployment
# Nothing below is needed for local development: it uses a SQLite file in data/, files on disk, and
# AUTH_DEV_LOGIN to sign in without ORCID. A hosted deployment sets APP_ENV=production, and the server then
# refuses to start until the settings marked (production) are present.

# The public address of the app, used for the ORCID callback and cookies. (production: https://...)
APP_URL=http://localhost:8000
# APP_ENV=production
# A long random string; signs sign-in state and download links. (production)
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL connection string; empty uses data/nemosearch-v2.db. (production)
# On serverless hosts, use the provider's pooled connection string.
DATABASE_URL=

# Sign in with ORCID. Register an app at https://orcid.org/developer-tools (or https://sandbox.orcid.org
# while testing) with the redirect URI {APP_URL}/api/auth/orcid/callback. (production)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://orcid.org
# Local only: sign in as any name / ORCID iD without ORCID. Refused unless APP_URL is localhost.
AUTH_DEV_LOGIN=1
# ORCID iDs with the admin role (verify organizations, review reports, take works down), comma-separated
ADMIN_ORCIDS=

# Private file storage for attachments and published works. (production: s3)
# Any S3-compatible bucket with public access blocked: AWS S3, Cloudflare R2, Backblaze B2, Supabase Storage.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: email a short notice when someone sends a request (in-app notifications always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional per-account limits over 24 hours
# LIMIT_RESEARCH_PER_DAY=40
# LIMIT_UPLOADS_PER_DAY=20
# LIMIT_REQUESTS_PER_DAY=15
# MAX_WORK_MB=25
